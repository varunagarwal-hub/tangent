# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Latest Flash model: detective on typed text, coach, explanations
GEMINI_MODEL_FAST=gemini-3.8-flash
# Latest Pro model: verifier, vision/handwriting, lesson plans
GEMINI_MODEL_SMART=gemini-3.1-pro-preview

# Neon Postgres — pooled connection string (Neon console → Connect, "Pooled connection")
DATABASE_URL=

# Vercel Blob (Vercel → Storage → Blob). Optional locally: without it, images go straight to Gemini and aren't stored.
BLOB_READ_WRITE_TOKEN=
